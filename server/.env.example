# Server Configuration
PORT=5000

# Allowed frontend client origin(s) for CORS.
# Separate multiple URLs with commas if deploying frontend across multiple domains/previews:
# e.g., CLIENT_URL=http://localhost:3000,https://my-crystal-frontend.vercel.app,*.vercel.app
CLIENT_URL=http://localhost:3000

# MongoDB Database Connection
MONGODB_URI=your_mongodb_connection_string_here
MONGODB_DB=Crystal-Estate
